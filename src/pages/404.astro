---
import BaseLayout from '../layouts/BaseLayout.astro';

const description = '页面不存在。';
---

<BaseLayout title="404" description={description} path="/404">
  <div class="mx-auto flex max-w-7xl 2xl:max-w-[88rem] flex-col items-start px-5 py-24 md:px-8 md:py-32">
    <p class="font-mono text-sm text-accent">404</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-ink md:text-4xl">页面不存在</h1>
    <p class="mt-4 text-[15px] text-muted">你要找的页面可能已被移动或删除。</p>
    <a href="/" class="btn btn-primary mt-8">返回首页</a>
  </div>
</BaseLayout>
