---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHead from '../../components/SectionHead.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/projects';

const projects = await getProjects();
const description =
  '兰永重的核心项目，涵盖 GraphRAG 问答、大模型应用工程、后端系统架构、目标与干扰识别，以及多模态情感预测与可解释分析。';
---

<BaseLayout title="项目" description={description} path="/projects">
  <section class="zone-dark" aria-labelledby="projects-page-title">
    <div class="mx-auto max-w-[1240px] px-5 pt-12 pb-24 md:px-8 md:pt-16">
      <SectionHead
        dark
        center
        id="projects-page-title"
        num="05"
        en="Work"
        title="Selected Work"
        desc={`${projects.length} 个项目覆盖大模型应用工程、后端系统架构、机器学习模型工程、多模态情感预测与可解释分析。01 为核心 Case Study。`}
      />

      <div class="space-y-20 md:space-y-28">
        {projects.map((project, i) => <ProjectCard project={project} index={i} />)}
      </div>
    </div>
  </section>
</BaseLayout>
