---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHead from '../../components/SectionHead.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/projects';

const projects = await getProjects();
const description =
  '兰永重的核心项目：法律法规智能知识图谱与 GraphRAG 问答系统、复杂低空场景目标识别系统、多模态深度学习干扰智能识别系统。';
---

<BaseLayout title="项目" description={description} path="/projects">
  <div class="mx-auto max-w-7xl 2xl:max-w-[88rem] px-5 pt-12 pb-24 md:px-8 md:pt-16">
    <SectionHead
      center
      eyebrow="项目案例"
      title="核心项目"
      desc="三个项目分别覆盖大模型应用工程、机器学习模型工程与深度学习实验分析。01 为核心 Case Study。"
    />

    <div class="space-y-20 md:space-y-28">
      {projects.map((project, i) => <ProjectCard project={project} index={i} />)}
    </div>
  </div>
</BaseLayout>
