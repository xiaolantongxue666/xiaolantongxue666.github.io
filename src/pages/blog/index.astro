---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHead from '../../components/SectionHead.astro';
import { getPosts, formatDate } from '../../lib/blog';

const posts = await getPosts();

// 按年份分组（倒序），同一篇列表内保持时间倒序
const years: { year: string; posts: typeof posts }[] = [];
for (const post of posts) {
  const year = String(post.data.pubDate.getUTCFullYear());
  const group = years.find((g) => g.year === year);
  if (group) group.posts.push(post);
  else years.push({ year, posts: [post] });
}

const description =
  '兰永重的博客：RAG / GraphRAG 与大模型应用开发笔记、机器学习工程实践，以及个人项目的复盘与思考。';
---

<BaseLayout title="博客" description={description} path="/blog">
  <div class="mx-auto max-w-7xl 2xl:max-w-[88rem] px-5 pt-12 pb-24 md:px-8 md:pt-16">
    <SectionHead
      center
      eyebrow="写作"
      title="博客"
      desc="记录开发笔记、工程实践与项目复盘。偶尔更新，尽量不水。"
    />

    <div class="mx-auto max-w-3xl">
      {
        years.map((group) => (
          <section class="mb-10 last:mb-0" aria-label={`${group.year} 年文章`}>
            <p class="font-mono text-lg font-bold text-accent-strong">{group.year}</p>
            <ul class="mt-4 divide-y divide-line rounded-xl border border-line bg-white" role="list">
              {group.posts.map((post) => (
                <li>
                  <a
                    href={`/blog/${post.id}`}
                    class="group block px-7 py-6 transition-colors hover:bg-white/60 md:px-9"
                  >
                    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                      <h3 class="text-lg font-semibold tracking-tight text-ink transition-colors group-hover:text-accent-strong">
                        {post.data.title}
                      </h3>
                      <time
                        datetime={formatDate(post.data.pubDate)}
                        class="font-mono text-xs tracking-wide text-faint"
                      >
                        {formatDate(post.data.pubDate)}
                      </time>
                    </div>
                    <p class="mt-2 text-sm leading-relaxed text-muted">
                      {post.data.description}
                    </p>
                    {
                      post.data.tags.length > 0 && (
                        <ul class="mt-3.5 flex flex-wrap gap-2" aria-label="标签">
                          {post.data.tags.map((tag) => (
                            <li class="chip">{tag}</li>
                          ))}
                        </ul>
                      )
                    }
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }

      {
        posts.length === 0 && (
          <div class="rounded-xl border border-line bg-white px-8 py-16 text-center">
            <p class="text-sm text-muted">文章还在路上，敬请期待。</p>
          </div>
        )
      }

      <p class="mt-10 text-center text-sm text-faint">
        <a
          href="/rss.xml"
          class="arrow-link inline-flex items-center gap-1 transition-colors hover:text-accent-strong"
        >
          RSS 订阅 <span class="arrow" aria-hidden="true">↗</span>
        </a>
      </p>
    </div>
  </div>
</BaseLayout>
