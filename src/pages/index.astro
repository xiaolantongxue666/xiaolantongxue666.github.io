---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Capabilities from '../components/Capabilities.astro';
import BentoGrid from '../components/BentoGrid.astro';
import SectionDots from '../components/SectionDots.astro';
import SectionHead from '../components/SectionHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
import EditorialCV from '../components/EditorialCV.astro';
import SkillGroup from '../components/SkillGroup.astro';
import { SITE } from '../config';
import { getProjects } from '../lib/projects';

const description =
  '兰永重的个人技术 Portfolio，展示 AI 大模型应用、RAG / GraphRAG、知识图谱、Python、机器学习与模型部署相关项目和实习经历。';

const projects = await getProjects();

const cv = [
  {
    period: '2026.05 — 07',
    company: '浮木科技有限公司',
    role: 'AI 大模型开发实习',
    project: '法律法规知识图谱与问答系统',
    tech: ['Document AI', 'GraphRAG', 'Neo4j', 'RAGFlow'],
    desc: '参与从文档解析、知识图谱构建、向量检索到 GraphRAG 问答的完整链路，后期独立负责图谱制作模块：跨页表格解析、本体约束的知识抽取与多模型交叉校验。',
  },
  {
    period: '2023.07 — 09',
    company: '北京前锋互联科技有限公司武汉分公司',
    role: '数据分析师实习',
    project: '抖音数据采集与数据分析',
    tech: ['Python', 'Selenium', 'Pandas'],
    desc: '基于 Python、Selenium 和浏览器驱动搭建数据采集流程，完成数据爬取、清洗与结构化整理，使用 Pandas 进行统计分析与可视化输出。',
  },
];

const skillMatrix = [
  { num: '01', title: 'Programming', skills: ['Python', 'SQL', 'Java', 'C'] },
  { num: '02', title: 'AI / ML', skills: ['PyTorch', 'Transformers', 'Machine Learning', 'Deep Learning'] },
  { num: '03', title: 'LLM Applications', skills: ['RAG', 'GraphRAG', 'RAGFlow', 'Prompt Engineering'] },
  { num: '04', title: 'Knowledge & Retrieval', skills: ['Neo4j', 'Elasticsearch', 'ChromaDB', 'Vector Retrieval'] },
  { num: '05', title: 'Document AI', skills: ['MinerU', 'DeepDoc', 'OCR', 'Document Parsing'] },
  { num: '06', title: 'Deployment', skills: ['ONNX', 'Int8', 'RK3588', 'Jetson'] },
];

const pathSteps = [
  { year: '2023', label: 'Python / Data' },
  { year: '2025', label: 'ML / DL' },
  { year: '2026', label: 'RAG / Knowledge Graph' },
];
---

<BaseLayout title={SITE.name} description={description} path="/">
  <SectionDots />
  <Hero />

  <!-- 02 / ABOUT -->
  <section id="about" class="scroll-mt-20" aria-labelledby="about-title">
    <div class="reveal mx-auto max-w-[1000px] px-5 py-16 md:px-8 md:py-24">
      <SectionHead num="02" en="About" id="about-title" title="从数据，到模型，再到 AI 应用" />

      <div class="grid gap-12 md:grid-cols-[1fr_240px] md:gap-16">
        <div class="space-y-5 text-[15px] leading-[2] text-muted md:text-base">
          <p>
            我目前是长江大学硕士在读，技术方向集中在 Python、机器学习与 AI
            大模型应用。
          </p>
          <p>
            我的实践从 Python
            数据采集与分析开始，之后参与雷达目标识别、多模态干扰识别等机器学习与深度学习项目；2026
            年在浮木科技实习期间，完成了从文档解析、知识图谱构建到 GraphRAG
            问答的完整链路。
          </p>
          <p>
            相比只关注模型调用，我更希望理解一个 AI
            应用从数据进入系统，到解析、检索、模型推理，再到最终业务结果的完整工程链路。
          </p>
        </div>

        <!-- 成长路径：年份 + 细线 + 节点 + 关键词 -->
        <ol class="relative space-y-8 border-l border-line pl-6" role="list">
          {
            pathSteps.map((step, i) => (
              <li class="relative">
                <span
                  class:list={[
                    'absolute top-1 -left-[27px] block size-2.5 rounded-full border-2 border-paper',
                    i === pathSteps.length - 1 ? 'bg-accent' : 'bg-faint',
                  ]}
                  aria-hidden="true"
                />
                <p class="font-mono text-sm font-medium text-ink">{step.year}</p>
                <p class="mt-1 text-sm text-muted">{step.label}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- 03 / CAPABILITIES -->
  <section id="capabilities" class="scroll-mt-20" aria-labelledby="capabilities-title">
    <div class="reveal mx-auto max-w-[1180px] px-5 py-16 md:px-8 md:py-24">
      <SectionHead
        center
        id="capabilities-title"
        num="03"
        en="Capabilities"
        title="我能做什么"
      />
      <Capabilities />
    </div>
  </section>

  <!-- 04 / STACK -->
  <section id="stack" class="scroll-mt-20" aria-labelledby="stack-title">
    <div class="reveal mx-auto max-w-[1080px] px-5 py-16 md:px-8 md:py-24">
      <SectionHead center id="stack-title" num="04" en="Stack" title="Tools I Work With" />
      <div class="grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        {skillMatrix.map((group) => <SkillGroup title={group.title} num={group.num} skills={group.skills} />)}
      </div>
    </div>
  </section>

  <!-- 05 / WORK：深色项目展示区 -->
  <section id="work" class="zone-dark scroll-mt-20" aria-labelledby="work-title">
    <div class="reveal mx-auto max-w-[1240px] px-5 py-20 md:px-8 md:py-28">
      <SectionHead
        dark
        center
        id="work-title"
        num="05"
        en="Work"
        title="Selected Work"
        desc="三个项目分别覆盖大模型应用工程、机器学习模型工程与深度学习实验分析——01 为核心 Case Study。"
      />

      <BentoGrid class="mb-20 md:mb-28" />

      <div class="space-y-20 md:space-y-28">
        {projects.map((project, i) => <ProjectCard project={project} index={i} />)}
      </div>
    </div>
  </section>

  <!-- 06 / EXPERIENCE -->
  <section id="experience" class="scroll-mt-20" aria-labelledby="experience-heading">
    <div class="reveal mx-auto max-w-[1000px] px-5 py-16 md:px-8 md:py-24">
      <SectionHead center id="experience-heading" num="06" en="Experience" title="Where I've Worked" />

      <!-- Career Path：2025 为研究生项目阶段，不作为实习经历表述 -->
      <div class="mb-3 grid gap-6 border-b border-line pb-10 sm:grid-cols-3">
        {[
          { year: '2023', label: 'Data Analysis' },
          { year: '2025', label: 'Machine Learning' },
          { year: '2026', label: 'AI Application Engineering' },
        ].map((step, i) => (
          <div class="flex items-baseline gap-3 sm:flex-col sm:gap-1.5">
            <p class="font-mono text-base font-semibold text-ink">{step.year}</p>
            <p class="font-mono text-[13px] tracking-wide text-muted uppercase">{step.label}</p>
            {i < 2 && (
              <span class="hidden text-line sm:ml-auto sm:block" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </span>
            )}
          </div>
        ))}
      </div>
      <p class="mb-12 text-xs text-faint">* 2025 为研究生项目阶段，非实习经历。</p>

      <EditorialCV items={cv} />
    </div>
  </section>

  <!-- 07 / EDUCATION + LET'S CONNECT -->
  <section id="education" class="scroll-mt-20" aria-labelledby="education-heading">
    <div class="reveal mx-auto max-w-[1000px] px-5 pb-10 md:px-8">
      <SectionHead center id="education-heading" num="07" en="Education" title="Education" />

      <div class="grid gap-10 sm:grid-cols-2">
        <div class="border-t border-line pt-6">
          <p class="font-mono text-xs tracking-wide text-faint">2024 — 2027</p>
          <h3 class="mt-2 text-lg font-semibold text-ink">长江大学 · 硕士</h3>
          <p class="mt-3 font-mono text-[13px] leading-relaxed text-muted">
            Machine Learning · Deep Learning · Computer Vision
          </p>
        </div>
        <div class="border-t border-line pt-6">
          <p class="font-mono text-xs tracking-wide text-faint">2020 — 2024</p>
          <h3 class="mt-2 text-lg font-semibold text-ink">长江大学 · 本科</h3>
          <p class="mt-3 font-mono text-[13px] leading-relaxed text-muted">
            Python · Data Structure · Signal Systems
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="connect" class="scroll-mt-20" aria-labelledby="connect-title">
    <div class="reveal mx-auto max-w-[1000px] px-5 pt-6 pb-24 md:px-8">
      <div class="border-t border-line pt-16 text-center">
        <p class="sec-num mx-auto">Let's Connect</p>
        <h2
          id="connect-title"
          class="mt-5 text-3xl font-semibold tracking-tight text-ink md:text-4xl"
        >
          Let's connect.
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-[15px] leading-relaxed text-muted">
          对 AI Application、Python / ML
          以及相关工程岗位保持开放，欢迎通过邮件或 GitHub 交流。
        </p>

        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <a href={`mailto:${SITE.email}`} class="btn btn-primary">Email me</a>
          <a
            href={SITE.github}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary"
          >
            GitHub
          </a>
        </div>
        <p class="mt-6 font-mono text-xs text-faint">{SITE.email}</p>
      </div>
    </div>
  </section>
</BaseLayout>
