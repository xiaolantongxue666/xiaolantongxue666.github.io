---
interface Props {
  title: string;
  skills: string[];
}
const { title, skills } = Astro.props;
---

<div>
  <h3 class="text-sm font-semibold tracking-wide text-ink">{title}</h3>
  <ul class="mt-3.5 flex flex-wrap gap-2" role="list" aria-label={`${title} 技能`}>
    {skills.map((s) => <li class="chip">{s}</li>)}
  </ul>
</div>
