---
import { SITE } from '../config';

const nav = [
  { label: '项目', href: '/projects' },
  { label: '经历', href: '/#experience' },
  { label: '关于', href: '/about' },
];

const { path = Astro.url.pathname } = Astro.props as { path?: string };
const isActive = (href: string) =>
  href === '/projects' ? path.startsWith('/projects') : path === href.split('#')[0] && !href.includes('#');

---

<header class="sticky top-0 z-40 border-b border-white/60 bg-white/70 backdrop-blur-xl">
  <div class="mx-auto flex h-16 max-w-7xl 2xl:max-w-[88rem] items-center justify-between px-5 md:px-8">
    <a
      href="/"
      class="text-[15px] font-semibold tracking-tight text-ink transition-colors hover:text-accent-deep"
    >
      {SITE.name}
    </a>

    <!-- 桌面导航 -->
    <nav aria-label="主导航" class="hidden items-center gap-1.5 md:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-full px-3.5 py-1.5 text-sm transition-colors',
              isActive(item.href)
                ? 'bg-accent/10 font-medium text-accent-deep'
                : 'text-muted hover:bg-white hover:text-ink',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={`mailto:${SITE.email}`}
        class="ml-2 rounded-full border border-line bg-white/80 px-3.5 py-1.5 text-sm text-ink transition-all hover:border-accent/40 hover:text-accent-deep hover:shadow-soft"
      >
        联系我
      </a>
    </nav>

    <!-- 移动端菜单按钮 -->
    <button
      id="menu-btn"
      type="button"
      class="flex h-10 w-10 items-center justify-center rounded-md text-ink md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="打开菜单"
    >
      <svg id="icon-open" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M3 5.5h14M3 10h14M3 14.5h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
      <svg id="icon-close" width="20" height="20" viewBox="0 0 20 20" fill="none" class="hidden" aria-hidden="true">
        <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <!-- 移动端菜单面板 -->
  <nav
    id="mobile-menu"
    aria-label="移动端导航"
    class="hidden border-t border-white/60 bg-white/85 backdrop-blur-xl md:hidden"
  >
    <div class="mx-auto flex max-w-7xl 2xl:max-w-[88rem] flex-col px-5 py-3">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="border-b border-line py-3 text-[15px] text-ink last:border-0"
          >
            {item.label}
          </a>
        ))
      }
      <a href={`mailto:${SITE.email}`} class="py-3 text-[15px] font-medium text-accent-deep">
        联系我
      </a>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  function setOpen(open: boolean) {
    if (!btn || !menu || !iconOpen || !iconClose) return;
    menu.classList.toggle('hidden', !open);
    iconOpen.classList.toggle('hidden', open);
    iconClose.classList.toggle('hidden', !open);
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
  }

  btn?.addEventListener('click', () => {
    setOpen(menu?.classList.contains('hidden') ?? false);
  });

  // 点击菜单项后收起
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
</script>
