---
import { SITE } from '../config';

const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div class="mx-auto max-w-7xl 2xl:max-w-[88rem] px-5 py-12 md:px-8">
    <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
      <div>
        <p class="text-[15px] font-semibold tracking-tight text-ink">{SITE.name}</p>
        <p class="mt-1.5 text-sm text-muted">{SITE.role} · {SITE.roleSub}</p>
      </div>

      <nav aria-label="页脚导航" class="flex flex-col gap-2.5 text-sm md:items-end">
        <a href="/projects" class="text-muted transition-colors hover:text-ink">项目</a>
        <a href="/about" class="text-muted transition-colors hover:text-ink">关于</a>
        <a
          href={SITE.github}
          target="_blank"
          rel="noopener noreferrer"
          class="text-muted transition-colors hover:text-ink"
        >
          GitHub
        </a>
        <a
          href={`mailto:${SITE.email}`}
          class="text-muted transition-colors hover:text-ink"
        >
          {SITE.email}
        </a>
      </nav>
    </div>

    <div class="mt-10 flex flex-col gap-1 border-t border-line pt-6 text-xs text-faint md:flex-row md:items-center md:justify-between">
      <p>© {year} {SITE.name} · 保留所有权利</p>
      <p>基于 Astro 与 Tailwind CSS 构建</p>
    </div>
  </div>
</footer>
