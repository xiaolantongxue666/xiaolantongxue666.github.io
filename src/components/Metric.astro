---
interface Props {
  value: string;
  label: string;
  /** 大号指标或紧凑指标 */
  size?: 'lg' | 'md';
}
const { value, label, size = 'md' } = Astro.props;

const arrowIndex = value.indexOf('→');
const before = arrowIndex > -1 ? value.slice(0, arrowIndex).trim() : null;
const after = arrowIndex > -1 ? value.slice(arrowIndex + 1).trim() : null;
---

<div class="flex flex-col">
  <span
    class:list={[
      'font-semibold tracking-tight text-ink tabular-nums',
      size === 'lg' ? 'text-3xl md:text-4xl' : 'text-xl md:text-2xl',
    ]}
  >
    {
      before !== null && after !== null ? (
        <>
          <span class="text-faint">{before}</span>
          <span class="mx-1 font-normal text-accent" aria-hidden="true">
            →
          </span>
          {after}
          <span class="sr-only">
            {before} 提升到 {after}
          </span>
        </>
      ) : (
        value
      )
    }
  </span>
  <span class:list={['mt-1 text-xs leading-relaxed text-faint', size === 'lg' && 'md:text-[13px]']}>
    {label}
  </span>
</div>
