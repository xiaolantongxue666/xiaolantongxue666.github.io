---
interface Props {
  value: string;
  label: string;
  /** 大号指标（Bento / 面板）或紧凑指标（卡片内） */
  size?: 'lg' | 'md';
  /** 渐变数字（默认开，柔和科技风的主视觉） */
  gradient?: boolean;
}
const { value, label, size = 'md', gradient = true } = Astro.props;

const arrowIndex = value.indexOf('→');
const before = arrowIndex > -1 ? value.slice(0, arrowIndex).trim() : null;
const after = arrowIndex > -1 ? value.slice(arrowIndex + 1).trim() : null;

const valueClass = [
  'font-bold tracking-tight tabular-nums',
  size === 'lg' ? 'text-3xl md:text-4xl' : 'text-xl md:text-2xl',
  gradient ? 'text-grad' : 'text-ink',
].join(' ');
---

<div class="flex flex-col">
  <span class={valueClass}>
    {
      before !== null && after !== null ? (
        <>
          {/* 注意：before 用实色弱化而非 opacity，子层透明度会脱离父级渐变裁切导致文字不可见 */}
          <span class="text-faint">{before}</span>
          <span class="mx-1 font-normal" aria-hidden="true">
            →
          </span>
          {after}
          <span class="sr-only">
            {before} 提升到 {after}
          </span>
        </>
      ) : (
        value
      )
    }
  </span>
  <span class:list={['mt-1 text-xs leading-relaxed text-faint', size === 'lg' && 'md:text-[13px]']}>
    {label}
  </span>
</div>
