---
/**
 * 侧边章节锚点：桌面端右侧固定圆点导航，滚动时高亮当前章节。
 */
const sections = [
  { id: 'what-i-do', label: '技术方向' },
  { id: 'projects', label: '核心项目' },
  { id: 'experience', label: '实习经历' },
  { id: 'skills', label: '技术能力' },
  { id: 'education', label: '教育背景' },
  { id: 'contact', label: '联系方式' },
];
---

<nav
  id="section-dots"
  aria-label="页面章节导航"
  class="fixed top-1/2 right-6 z-30 hidden -translate-y-1/2 xl:block"
>
  <ul class="flex flex-col items-center gap-3.5" role="list">
    {
      sections.map((s) => (
        <li>
          <a href={`#${s.id}`} data-dot={s.id} class="group relative flex items-center justify-center p-1">
            <span class="dot" aria-hidden="true" />
            <span class="pointer-events-none absolute right-6 rounded-full border border-line bg-white/90 px-2.5 py-0.5 text-xs whitespace-nowrap text-muted opacity-0 shadow-card transition-opacity group-hover:opacity-100">
              {s.label}
            </span>
            <span class="sr-only">{s.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  const dots = document.querySelectorAll<HTMLAnchorElement>('#section-dots [data-dot]');

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        for (const dot of dots) {
          dot.querySelector('.dot')?.classList.toggle(
            'active',
            dot.getAttribute('data-dot') === entry.target.id,
          );
        }
      }
    },
    { rootMargin: '-40% 0px -55% 0px' },
  );

  for (const { id } of [
    { id: 'what-i-do' },
    { id: 'projects' },
    { id: 'experience' },
    { id: 'skills' },
    { id: 'education' },
    { id: 'contact' },
  ]) {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  }
</script>
