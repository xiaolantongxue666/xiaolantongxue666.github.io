---
import { SITE } from '../config';

/** Hero 右侧技术目录：编辑式刊物感 */
const keywords = [
  { label: 'AI APPLICATION', num: '01' },
  { label: 'PYTHON / ML', num: '02' },
  { label: 'KNOWLEDGE GRAPH', num: '03' },
  { label: 'MODEL ENGINEERING', num: '04' },
];
---

<section class="mx-auto max-w-[1200px] px-5 pt-16 pb-20 md:px-8 md:pt-24 md:pb-28">
  <div class="grid gap-12 lg:grid-cols-[65%_35%] lg:gap-8">
    <!-- 左 65%：身份与 CTA -->
    <div>
      <div class="flex items-center justify-between font-mono text-xs tracking-[0.18em] text-faint uppercase">
        <span>01 / Portfolio</span>
        <span>2026</span>
      </div>

      <h1 class="mt-8 text-[44px] leading-[0.95] font-semibold tracking-tight text-ink sm:text-[56px] md:text-[72px] xl:text-[80px]">
        {SITE.name}
      </h1>

      <p class="mt-6 text-xl font-medium tracking-tight text-ink md:text-2xl">
        AI Application Developer
      </p>
      <p class="mt-1 text-xl font-medium tracking-tight text-muted md:text-2xl">
        Python / Machine Learning
      </p>

      <p class="mt-7 max-w-[580px] text-[17px] leading-[1.7] text-muted">
        长江大学硕士在读，关注大模型应用、RAG / GraphRAG、知识图谱与机器学习工程——从文档解析到端侧部署，每一环都亲手做过。
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a href="/projects" class="btn btn-primary">
          查看项目
          <span aria-hidden="true">→</span>
        </a>
        <a href={`mailto:${SITE.email}`} class="btn btn-secondary">联系我</a>
      </div>
    </div>

    <!-- 右 35%：技术关键词目录 -->
    <div class="hidden flex-col justify-end lg:flex" aria-hidden="true">
      <ul role="list" class="space-y-5">
        {
          keywords.map((k) => (
            <li class="flex items-baseline justify-between border-t border-line pt-3">
              <span class="font-mono text-[13px] tracking-[0.16em] text-muted">{k.label}</span>
              <span class="font-mono text-xs text-faint">{k.num}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
