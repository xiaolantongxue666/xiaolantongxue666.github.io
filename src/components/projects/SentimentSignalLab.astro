---
const bins = Array.from({ length: 20 }, (_, index) => index);
const tracks = [
  { key: 'text', name: '文本', heights: [11, 16, 9, 18, 13, 8, 15, 11, 18, 13, 9, 16, 11, 17, 8, 14, 18, 10, 15, 12] },
  { key: 'audio', name: '语音', heights: [5, 9, 18, 28, 13, 7, 21, 29, 18, 10, 6, 14, 26, 31, 20, 12, 5, 15, 23, 8] },
  { key: 'vision', name: '视觉', heights: [14, 20, 17, 25, 19, 15, 22, 27, 18, 13, 21, 26, 18, 23, 29, 20, 15, 24, 19, 14] },
];
---

<sentiment-signal-lab>
  <section class="signal-lab" aria-label="缺失掩码交互示意">
    <header class="window-header">
      <span class="window-name"><span class="prompt-mark" aria-hidden="true">&gt;_</span> alignment.lab</span>
      <span class="file-type">interactive study</span>
    </header>

    <div class="lab-content">
      <div class="lab-heading">
        <h2>缺失掩码交互示意</h2>
        <span class="step-size">Δt = 0.2 s</span>
      </div>
      <p class="lab-intro">将三种模态对齐到同一时间网格，观察连续缺失如何编码。</p>

      <div class="timeline" aria-hidden="true">
        <div class="time-labels"><span>0.0</span><span>1.0</span><span>2.0</span><span>3.0</span><span>4.0 s</span></div>
        <div class="window-rail"><span class="window-marker"></span></div>
      </div>

      <div class="tracks" role="group" aria-label="三模态有效性掩码；每格代表 0.2 秒">
        {tracks.map((track) => (
          <div class={`track track-${track.key}`} data-track={track.key}>
            <div class="track-header">
              <span class="track-name"><span class="modality-dot" aria-hidden="true"></span>{track.key}<span class="track-translation">{track.name}</span></span>
              <span class="track-state" data-track-state>{track.key === 'audio' ? '连续 4 格缺失' : '全程有效'}</span>
            </div>
            <div class="signal-grid" aria-hidden="true">
              {bins.map((index) => (
                <span class:list={['signal-cell', { 'is-missing': track.key === 'audio' && index >= 6 && index < 10 }]} data-bin={index}>
                  <span class="signal-glyph" style={`--glyph-height:${track.heights[index]}px;--glyph-offset:${index % 3 * 3}px`}></span>
                  <span class="missing-glyph">×</span>
                </span>
              ))}
            </div>
            <div class="mask-grid" role="img" aria-label={`${track.name}掩码：${track.key === 'audio' ? '第 7 至 10 格为 0，其余为 1' : '全部为 1'}`} data-mask-row>
              {bins.map((index) => (
                <span class:list={['mask-bit', { 'is-missing': track.key === 'audio' && index >= 6 && index < 10 }]} data-mask-bin={index} aria-hidden="true">{track.key === 'audio' && index >= 6 && index < 10 ? '0' : '1'}</span>
              ))}
            </div>
          </div>
        ))}
      </div>

      <div class="mask-key"><span><i class="key-valid" aria-hidden="true"></i><b>1</b> 有效输入</span><span><i class="key-missing" aria-hidden="true"></i><b>0</b> 缺失输入</span><span class="mask-label">validity mask</span></div>

      <fieldset class="lab-controls" disabled>
        <legend>模拟连续区间缺失</legend>
        <div class="modality-controls">
          <span class="control-label">遮蔽模态</span>
          <div class="modality-options">
            {tracks.map((track) => (
              <label class={`modality-option option-${track.key}`}>
                <input type="checkbox" name="masked-modality" value={track.key} checked={track.key === 'audio'} />
                <span>{track.name}</span>
              </label>
            ))}
          </div>
        </div>
        <label class="window-control">
          <span class="range-heading"><span class="control-label">窗口起点</span><output data-range-value>1.2 s</output></span>
          <input type="range" name="window-start" min="0" max="16" step="1" value="6" aria-valuetext="1.2 秒；遮蔽窗口 1.2 至 2.0 秒" />
          <span class="range-scale" aria-hidden="true"><span>0.0 s</span><span>窗口宽度固定 0.8 s</span><span>3.2 s</span></span>
        </label>
      </fieldset>

      <p class="lab-status" role="status" aria-live="polite" aria-atomic="true"><span class="status-marker" aria-hidden="true">↳</span><span data-status-text>语音在 [1.2, 2.0) s 内的掩码为 0；文本、视觉保持有效。</span></p>
      <p class="lab-disclaimer">抽象信号与时间片段仅作原理示意，不对应真实样本或模型推理结果。</p>
      <noscript><p class="noscript-note">当前为静态示意；启用 JavaScript 后可调整遮蔽模态与窗口。</p></noscript>
    </div>
  </section>
</sentiment-signal-lab>

<script>
  class SentimentSignalLab extends HTMLElement {
    private events?: AbortController;

    connectedCallback() {
      if (this.events) return;
      const controls = this.querySelector<HTMLFieldSetElement>('fieldset');
      const slider = this.querySelector<HTMLInputElement>('input[type="range"]');
      if (!controls || !slider) return;

      this.events = new AbortController();
      controls.disabled = false;
      this.dataset.ready = 'true';
      const refresh = () => {
        const start = Number(slider.value);
        const selected = Array.from(this.querySelectorAll<HTMLInputElement>('input[type="checkbox"]:checked')).map((input) => input.value);
        const labels: Record<string, string> = { text: '文本', audio: '语音', vision: '视觉' };
        const from = (start * 0.2).toFixed(1);
        const to = ((start + 4) * 0.2).toFixed(1);
        const output = this.querySelector<HTMLOutputElement>('[data-range-value]');
        const marker = this.querySelector<HTMLElement>('.window-marker');
        if (output) output.value = `${from} s`;
        if (marker) marker.style.left = `${start * 5}%`;
        slider.setAttribute('aria-valuetext', `${from} 秒；遮蔽窗口 ${from} 至 ${to} 秒`);

        this.querySelectorAll<HTMLElement>('[data-track]').forEach((track) => {
          const key = track.dataset.track ?? '';
          const masked = selected.includes(key);
          track.querySelectorAll<HTMLElement>('[data-bin]').forEach((cell) => {
            const index = Number(cell.dataset.bin);
            cell.classList.toggle('is-missing', masked && index >= start && index < start + 4);
          });
          track.querySelectorAll<HTMLElement>('[data-mask-bin]').forEach((bit) => {
            const index = Number(bit.dataset.maskBin);
            const missing = masked && index >= start && index < start + 4;
            bit.classList.toggle('is-missing', missing);
            bit.textContent = missing ? '0' : '1';
          });
          const state = track.querySelector('[data-track-state]');
          if (state) state.textContent = masked ? '连续 4 格缺失' : '全程有效';
          track.querySelector('[data-mask-row]')?.setAttribute('aria-label', `${labels[key]}掩码：${masked ? `第 ${start + 1} 至 ${start + 4} 格为 0，其余为 1` : '全部为 1'}`);
        });

        const status = this.querySelector('[data-status-text]');
        if (status) {
          const remaining = Object.keys(labels).filter((key) => !selected.includes(key)).map((key) => labels[key]);
          status.textContent = selected.length
            ? `${selected.map((key) => labels[key]).join('、')}在 [${from}, ${to}) s 内的掩码为 0${remaining.length ? `；${remaining.join('、')}保持有效。` : '；窗口外的输入保持有效。'}`
            : '三种模态全程有效；选择任意模态以模拟连续区间缺失。';
        }
      };

      controls.addEventListener('input', refresh, { signal: this.events.signal });
      refresh();
    }

    disconnectedCallback() {
      this.events?.abort();
      this.events = undefined;
    }
  }

  if (!customElements.get('sentiment-signal-lab')) {
    customElements.define('sentiment-signal-lab', SentimentSignalLab);
  }
</script>

<style>
  sentiment-signal-lab { display: block; width: 100%; min-width: 0; }
  .signal-lab { --lab-bg: #101a29; --lab-ink: #e1edf5; --lab-muted: #a7b7c9; --lab-border: #293c50; box-sizing: border-box; overflow: hidden; width: 100%; margin: 0; border: 1px solid var(--lab-border); border-radius: 8px; background: var(--lab-bg); color: var(--lab-ink); font-family: "Cascadia Code", Consolas, "Microsoft YaHei", monospace; }
  .signal-lab *, .signal-lab *::before, .signal-lab *::after { box-sizing: border-box; }
  .window-header { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 13px 20px; border-bottom: 1px solid var(--lab-border); background: #132032; font-size: 12px; }
  .window-name { display: inline-flex; align-items: center; gap: 10px; white-space: nowrap; }
  .prompt-mark { color: #65deee; font-weight: 700; }
  .file-type { color: var(--lab-muted); font-size: 10px; }
  .lab-content { padding: 22px 20px 18px; }
  .lab-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; }
  .lab-heading h2 { margin: 0; color: var(--lab-ink); font-size: 15px; font-weight: 600; line-height: 1.6; letter-spacing: 0; }
  .step-size { color: #65deee; font-size: 11px; white-space: nowrap; }
  .lab-intro { margin: 9px 0 22px; color: var(--lab-muted); font-size: 11px; line-height: 1.9; }
  .timeline { margin: 0 0 17px; }
  .time-labels { display: flex; justify-content: space-between; color: var(--lab-muted); font-size: 10px; }
  .window-rail { position: relative; height: 7px; margin-top: 7px; border-top: 1px solid var(--lab-border); background: repeating-linear-gradient(90deg, var(--lab-border) 0, var(--lab-border) 1px, transparent 1px, transparent 5%); }
  .window-marker { position: absolute; top: -1px; left: 30%; width: 20%; height: 7px; border: 1px solid #a7b7c9; border-top-width: 2px; background: #a7b7c912; transition: left 100ms ease-out; }
  .tracks { display: grid; gap: 16px; }
  .track { --track-color: #65deee; --track-wash: #65deee12; min-width: 0; }
  .track-audio { --track-color: #f5b973; --track-wash: #f5b97312; }
  .track-vision { --track-color: #b5a3ff; --track-wash: #b5a3ff12; }
  .track-header { display: flex; justify-content: space-between; gap: 8px; align-items: center; margin-bottom: 7px; font-size: 11px; line-height: 1.4; }
  .track-name { display: inline-flex; align-items: center; gap: 7px; color: var(--track-color); }
  .modality-dot { width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
  .track-translation { color: var(--lab-muted); font-size: 10px; }
  .track-state { color: var(--lab-muted); font-size: 10px; }
  .signal-grid, .mask-grid { display: grid; grid-template-columns: repeat(20, minmax(0, 1fr)); gap: 3px; }
  .signal-cell { position: relative; display: flex; align-items: center; justify-content: center; overflow: hidden; height: 37px; border: 1px solid var(--lab-border); background: var(--track-wash); }
  .signal-glyph { display: block; width: 3px; max-width: 50%; height: var(--glyph-height); background: var(--track-color); opacity: 0.88; }
  .track-text .signal-glyph { width: 62%; max-width: 62%; height: 3px; box-shadow: 0 6px 0 var(--track-color); transform: translateY(calc(var(--glyph-offset) - 6px)); }
  .track-vision .signal-glyph { width: 65%; max-width: 65%; height: var(--glyph-height); border: 1px solid var(--track-color); background: linear-gradient(135deg, transparent 40%, var(--track-color) 41%, var(--track-color) 48%, transparent 49%); opacity: 0.65; }
  .missing-glyph { display: none; color: #a7b7c9; font-size: 12px; line-height: 1; }
  .signal-cell.is-missing { border: 1px dashed #53677b; background: repeating-linear-gradient(135deg, transparent, transparent 3px, #a7b7c90a 3px, #a7b7c90a 4px); }
  .signal-cell.is-missing .signal-glyph { display: none; }
  .signal-cell.is-missing .missing-glyph { display: block; }
  .mask-grid { margin-top: 4px; }
  .mask-bit { color: var(--track-color); font-size: 9px; line-height: 1.3; text-align: center; opacity: 0.85; }
  .mask-bit.is-missing { color: var(--lab-ink); opacity: 1; }
  .mask-key { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 15px; margin: 20px 0; color: var(--lab-muted); font-size: 10px; }
  .mask-key > span { display: inline-flex; align-items: center; gap: 5px; }
  .mask-key b { color: var(--lab-ink); font-weight: 400; }
  .mask-key i { display: inline-block; width: 8px; height: 8px; }
  .key-valid { border: 1px solid #65deee; background: #65deee26; }
  .key-missing { border: 1px dashed #a7b7c9; }
  .mask-key .mask-label { margin-left: auto; font-size: 9px; color: var(--lab-muted); }
  .lab-controls { display: block; min-width: 0; margin: 0; padding: 17px 0 0; border: 0; border-top: 1px solid var(--lab-border); }
  .lab-controls legend { padding: 0 9px 0 0; color: var(--lab-muted); font-size: 10px; }
  .modality-controls { display: flex; align-items: center; flex-wrap: wrap; justify-content: space-between; gap: 9px 15px; }
  .control-label { color: var(--lab-muted); font-size: 11px; }
  .modality-options { display: flex; align-items: center; flex-wrap: wrap; gap: 14px; }
  .modality-option { display: inline-flex; align-items: center; gap: 6px; min-height: 30px; color: var(--lab-ink); font-size: 11px; cursor: pointer; }
  .modality-option input { width: 14px; height: 14px; margin: 0; accent-color: #65deee; cursor: pointer; }
  .option-audio input { accent-color: #f5b973; }
  .option-vision input { accent-color: #b5a3ff; }
  .window-control { display: block; margin-top: 15px; }
  .range-heading { display: flex; align-items: center; justify-content: space-between; }
  .range-heading output { color: var(--lab-ink); font-size: 12px; font-variant-numeric: tabular-nums; }
  .window-control input { display: block; width: 100%; height: 24px; margin: 7px 0 2px; accent-color: #65deee; cursor: ew-resize; }
  .range-scale { display: flex; align-items: center; justify-content: space-between; gap: 6px; color: var(--lab-muted); font-size: 9px; }
  .modality-option input:focus-visible, .window-control input:focus-visible { outline: 2px solid #65deee; outline-offset: 4px; }
  .lab-controls:disabled label, .lab-controls:disabled input { cursor: default; }
  .lab-status { display: flex; gap: 8px; min-height: 49px; margin: 20px 0 0; padding: 11px 0 0; border-top: 1px solid var(--lab-border); color: var(--lab-ink); font-size: 11px; line-height: 1.8; }
  .status-marker { flex: 0 0 auto; color: #65deee; }
  .lab-disclaimer, .noscript-note { margin: 11px 0 0; color: var(--lab-muted); font-size: 10px; line-height: 1.8; }
  .noscript-note { color: #f5b973; }
  @media (max-width: 600px) {
    .window-header { padding: 12px 15px; }
    .lab-content { padding: 18px 15px 15px; }
    .file-type { display: none; }
    .signal-grid, .mask-grid { gap: 2px; }
  }
  @media (max-width: 360px) {
    .lab-content { padding-inline: 12px; }
    .lab-heading h2 { font-size: 14px; }
    .step-size { font-size: 10px; }
    .mask-key { gap: 8px 12px; }
    .mask-key .mask-label { display: none; }
    .modality-options { gap: 10px; }
    .track-translation { display: none; }
    .signal-grid, .mask-grid { gap: 1px; }
    .range-scale { font-size: 8px; }
  }
  @media (prefers-reduced-motion: reduce) { .window-marker { transition: none; } }
</style>
