---
/**
 * Bento 成果速览：深色项目区开头，快速扫成果（嵌套使用，不自带容器）。
 * GraphRAG 主项目占最大块并放真实截图；全部使用已确认指标。
 */
const { class: className = '' } = Astro.props;
---

<div class:list={['grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:grid-rows-2', className]} aria-label="核心项目成果">
  <!-- 主格：GraphRAG 真实截图 -->
  <a
    href="/projects/legal-knowledge-graphrag"
    class="img-hover group relative flex flex-col overflow-hidden rounded-2xl border border-[color:var(--color-night-line)] bg-white/[0.04] transition-colors hover:border-white/25 lg:col-span-2 lg:row-span-2"
  >
    <span class="absolute top-4 left-4 z-10 rounded-md border border-[color:var(--color-night-line)] bg-[#11161d]/85 px-2.5 py-1 font-mono text-[10px] tracking-[0.18em] text-night-muted uppercase">
      Real Project Output
    </span>
    <div class="min-h-0 flex-1 overflow-hidden">
      <img
        src="/images/projects/graphrag/knowledge-graph.png"
        alt="法律法规领域知识图谱运行结果可视化"
        width="1920"
        height="945"
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover object-top"
      />
    </div>
    <div class="p-6">
      <p class="font-mono text-[11px] tracking-[0.18em] text-night-muted uppercase">01 · GraphRAG</p>
      <p class="mt-2 text-lg font-semibold text-night-text">
        法律法规知识图谱与问答系统
        <span class="ml-2 inline-block text-sm text-[color:var(--night-link)]">
          查看案例 <span class="arrow" aria-hidden="true">→</span>
        </span>
      </p>
      <p class="mt-1 text-sm text-night-muted">文档解析 · 知识图谱 · 双路检索问答</p>
    </div>
  </a>

  <a
    href="/projects/legal-knowledge-graphrag"
    class="flex flex-col justify-center rounded-2xl border border-[color:var(--color-night-line)] bg-white/[0.04] p-6 transition-colors hover:border-white/25"
  >
    <p class="text-2xl font-semibold tracking-tight text-night-text tabular-nums">5000+</p>
    <p class="mt-1 text-xs leading-relaxed text-night-muted">Knowledge Graph Nodes</p>
  </a>

  <a
    href="/projects/legal-knowledge-graphrag"
    class="flex flex-col justify-center rounded-2xl border border-[color:var(--color-night-line)] bg-white/[0.04] p-6 transition-colors hover:border-white/25"
  >
    <p class="text-2xl font-semibold tracking-tight text-night-text tabular-nums">90 → 95%</p>
    <p class="mt-1 text-xs leading-relaxed text-night-muted">Retrieval Recall</p>
  </a>

  <a
    href="/projects/low-altitude-target-recognition"
    class="flex flex-col justify-center rounded-2xl border border-[color:var(--color-night-line)] bg-white/[0.04] p-6 transition-colors hover:border-white/25"
  >
    <p class="text-2xl font-semibold tracking-tight text-night-text tabular-nums">98.99%</p>
    <p class="mt-1 text-xs leading-relaxed text-night-muted">Radar Validation Accuracy</p>
  </a>

  <a
    href="/projects/multimodal-interference-recognition"
    class="flex flex-col justify-center rounded-2xl border border-[color:var(--color-night-line)] bg-white/[0.04] p-6 transition-colors hover:border-white/25"
  >
    <p class="text-2xl font-semibold tracking-tight text-night-text tabular-nums">92.71% / 0.8398</p>
    <p class="mt-1 text-xs leading-relaxed text-night-muted">Multimodal Recognition</p>
  </a>
</div>
