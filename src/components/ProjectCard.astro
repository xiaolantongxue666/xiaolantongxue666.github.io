---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  /** 序号，奇偶决定图文左右交错 */
  index?: number;
}
const { project, index = 0 } = Astro.props;
const { title, titleEn, summary, tags, metrics, cover, coverAlt, order, slug } = project.data;
const href = `/projects/${slug}`;
const flip = index % 2 === 1;
---

<article class="grid items-center gap-9 lg:grid-cols-2 lg:gap-14">
  <!-- 文字侧 -->
  <div class:list={[flip && 'lg:order-2']}>
    <p class="font-mono text-sm text-night-muted" aria-hidden="true">
      {String(order).padStart(2, '0')}
    </p>
    <h3 class="mt-3 text-2xl font-semibold tracking-tight text-night-text">
      <a href={href} class="transition-colors hover:text-[color:var(--night-link)]">
        {title}
      </a>
    </h3>
    <p class="mt-1.5 font-mono text-xs tracking-wide text-night-muted">{titleEn}</p>
    <p class="mt-4 text-[15px] leading-[1.9] text-night-muted">{summary}</p>

    {
      metrics.length > 0 && (
        <div class="mt-6 grid grid-cols-1 gap-4 border-t border-[color:var(--color-night-line)] pt-6 sm:grid-cols-3 sm:gap-4">
          {metrics.map((m) => (
            <div>
              <p class="text-xl font-semibold tracking-tight text-night-text tabular-nums md:text-2xl">
                {m.value}
              </p>
              <p class="mt-1 text-xs text-night-muted">{m.label}</p>
            </div>
          ))}
        </div>
      )
    }

    <ul class="mt-5 flex flex-wrap gap-2" role="list">
      {tags.slice(0, 5).map((tag) => (
        <li class="chip font-mono text-[0.72rem]">{tag}</li>
      ))}
    </ul>

    <a
      href={href}
      class="arrow-link mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-[color:var(--night-link)]"
    >
      查看 Case Study <span class="arrow" aria-hidden="true">→</span>
    </a>
  </div>

  <!-- 视觉侧：真实截图或指标视觉面板（不放假截图） -->
  <div class:list={['min-w-0', flip && 'lg:order-1']}>
    {
      cover ? (
        <div class="img-hover overflow-hidden rounded-2xl border border-[color:var(--color-night-line)]">
          <img
            src={cover}
            alt={coverAlt ?? `${title} 界面截图`}
            width="1920"
            height="945"
            loading="lazy"
            decoding="async"
            class="h-auto w-full object-cover"
          />
        </div>
      ) : (
        <div class="relative flex flex-col justify-center gap-5 overflow-hidden rounded-2xl border border-[color:var(--color-night-line)] bg-white/[0.03] px-8 py-10 md:aspect-[16/10] md:gap-6 md:px-14 md:py-0">
          <svg
            class="pointer-events-none absolute -top-20 -right-20 opacity-40"
            width="260"
            height="260"
            viewBox="0 0 260 260"
            fill="none"
            aria-hidden="true"
          >
            <circle cx="130" cy="130" r="128" stroke="#9aa4b2" stroke-opacity="0.35" stroke-width="1" />
            <circle cx="130" cy="130" r="92" stroke="#9aa4b2" stroke-opacity="0.35" stroke-width="1" />
            <circle cx="130" cy="130" r="56" stroke="#9aa4b2" stroke-opacity="0.35" stroke-width="1" />
          </svg>
          <p class="font-mono text-xs tracking-widest text-night-muted">{titleEn}</p>
          <ul class="relative space-y-5" role="list">
            {metrics.map((m) => (
              <li class="flex flex-wrap items-baseline gap-x-4 gap-y-1 border-b border-[color:var(--color-night-line)] pb-4 last:border-0 last:pb-0">
                <span class="text-3xl font-semibold tracking-tight text-night-text tabular-nums md:text-4xl">
                  {m.value}
                </span>
                <span class="text-sm text-night-muted">{m.label}</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</article>
